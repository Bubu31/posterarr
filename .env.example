# URL de base de ton serveur Jellyfin (avec ou sans slash final)
JELLYFIN_URL=https://jellyfin.busolin.fr/
# Clé API Jellyfin (Tableau de bord -> API)
JELLYFIN_API_KEY=changeme
# Port d'écoute de posterarr (défaut 3939)
PORT=3939

# --- Sources de posters ---
# TMDB : themoviedb.org -> Paramètres -> API (clé v3)
TMDB_API_KEY=changeme
# Fanart.tv : fanart.tv/get-an-api-key
FANART_API_KEY=changeme
# TheTVDB v4 : thetvdb.com/dashboard -> API (laisser vide si non utilisé)
TVDB_API_KEY=

# Guérison automatique : intervalle en minutes (0 = désactivé, déclenchement manuel via /api/heal)
HEAL_INTERVAL_MIN=0
